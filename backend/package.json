{
  "name": "mechatroniqs-portal-backend",
  "version": "1.0.0",
  "description": "Industrial Service & Retrofit Management Portal - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "drive:authorize": "ts-node scripts/authorize-drive.ts",
    "add-user": "ts-node scripts/add-user.ts",
    "backup": "ts-node scripts/backup-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "googleapis": "^172.0.0",
    "jsonwebtoken": "^9.0.2",
    "mechatroniqs-portal": "file:..",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "openai": "^6.39.1",
    "pdfkit": "^0.18.0"
  },
  "prisma": {
    "seed": "ts-node src/prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.9",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.15.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
