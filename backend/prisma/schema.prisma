generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           String   @default("technician")
  createdAt      DateTime @default(now()) @map("created_at")

  projects        Project[]
  serviceReports  ServiceReport[]
  offersCreated   Offer[]       @relation("OfferCreator")
  mediaUploaded   MediaFile[]   @relation("MediaUploader")

  @@map("users")
}

model Customer {
  id                     String   @id @default(uuid())
  companyName            String   @map("company_name")
  vatNumber              String   @unique @map("vat_number")
  contactPerson          String?  @map("contact_person")
  email                  String?
  phone                  String?
  address                String
  createdAt              DateTime @default(now()) @map("created_at")
  driveFolderId          String?  @map("drive_folder_id")
  driveMediaFolderId     String?  @map("drive_media_folder_id")
  driveOffersFolderId    String?  @map("drive_offers_folder_id")
  driveContractsFolderId String?  @map("drive_contracts_folder_id")

  machines  Machine[]
  projects  Project[]
  offers    Offer[]

  @@map("customers")
}

model Machine {
  id             String   @id @default(uuid())
  customerId     String?  @map("customer_id")
  name           String
  model          String?
  serialNumber   String?  @unique @map("serial_number")
  manufacturer   String?
  technicalSpecs String?  @map("technical_specs")
  createdAt      DateTime @default(now()) @map("created_at")

  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projects  Project[]
  offers    Offer[]

  @@map("machines")
}

model Inventory {
  id               String   @id @default(uuid())
  partNumber       String   @unique @map("part_number")
  brand            String?
  name             String
  description      String?
  stockQuantity    Int      @default(0) @map("stock_quantity")
  safetyStockLevel Int      @default(5) @map("safety_stock_level")
  unitCost         Decimal  @map("unit_cost")
  unitPrice        Decimal  @map("unit_price")
  ceCertified             Boolean  @default(true) @map("ce_certified")
  driveFolderId           String?  @map("drive_folder_id")
  drivePhotosFolderId     String?  @map("drive_photos_folder_id")
  driveDatasheetsFolderId String?  @map("drive_datasheets_folder_id")

  projectMaterials ProjectMaterial[]

  @@map("inventory")
}

model DriveConfig {
  key   String @id
  value String

  @@map("drive_config")
}

model Project {
  id                   String   @id @default(uuid())
  customerId           String?  @map("customer_id")
  machineId            String?  @map("machine_id")
  title                String
  type                 String
  status               String   @default("draft")
  estimatedLaborHours  Decimal  @default(0.00) @map("estimated_labor_hours")
  actualLaborHours     Decimal  @default(0.00) @map("actual_labor_hours")
  quotedTotalPrice     Decimal  @map("quoted_total_price")
  termsAndConditions   String?  @map("terms_and_conditions")
  createdBy            String?  @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")

  customer         Customer?         @relation(fields: [customerId], references: [id])
  machine          Machine?          @relation(fields: [machineId], references: [id])
  creator          User?             @relation(fields: [createdBy], references: [id])
  projectMaterials ProjectMaterial[]
  serviceReports   ServiceReport[]

  @@map("projects")
}

model ProjectMaterial {
  id               String  @id @default(uuid())
  projectId        String  @map("project_id")
  inventoryId      String? @map("inventory_id")
  quantityRequired Int     @map("quantity_required")
  unitCostAtQuote  Decimal @map("unit_cost_at_quote")
  unitPriceAtQuote Decimal @map("unit_price_at_quote")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inventory Inventory? @relation(fields: [inventoryId], references: [id])

  @@map("project_materials")
}

model ServiceReport {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  technicianId     String?  @map("technician_id")
  workPerformed    String   @map("work_performed")
  hoursLogged      Decimal  @map("hours_logged")
  digitalSignature String?  @map("digital_signature")
  submittedAt      DateTime @default(now()) @map("submitted_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technician User?   @relation(fields: [technicianId], references: [id])

  @@map("service_reports")
}

// ─── Offers ──────────────────────────────────────────────────────────────────

model Offer {
  id            String   @id @default(uuid())
  customerId    String?  @map("customer_id")
  machineId     String?  @map("machine_id")
  title         String
  description   String?
  offerDate     DateTime @default(now()) @map("offer_date")
  validUntil    DateTime @map("valid_until")
  status        String   @default("draft")        // draft | sent | accepted | rejected | expired
  paymentStatus String   @default("unpaid") @map("payment_status")  // unpaid | invoiced | partially_paid | paid
  totalAmount   Decimal  @map("total_amount")
  notes         String?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer?   @relation(fields: [customerId], references: [id])
  machine  Machine?    @relation(fields: [machineId], references: [id])
  creator  User?       @relation("OfferCreator", fields: [createdBy], references: [id])
  items    OfferItem[]

  @@map("offers")
}

model OfferItem {
  id          String  @id @default(uuid())
  offerId     String  @map("offer_id")
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_items")
}

// ─── Media ────────────────────────────────────────────────────────────────────

model MediaFile {
  id           String   @id @default(uuid())
  entityType   String   @map("entity_type")   // 'customer' | 'machine'
  entityId     String   @map("entity_id")
  driveFileId  String   @map("drive_file_id")
  name         String
  mimeType     String   @map("mime_type")
  driveUrl     String   @map("drive_url")
  thumbnailUrl String?  @map("thumbnail_url")
  uploadedBy   String?  @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  uploader User? @relation("MediaUploader", fields: [uploadedBy], references: [id])

  @@map("media_files")
}
